@model IEnumerable<ProductViewModel>

@{
    ViewData["Title"] = "Low Stock Dashboard";
    int currentThreshold = ViewBag.Threshold is int t ? t : 10;
    var outOfStockCount = Model.Count(p => p.QuantityInStock == 0);
    var lowStockCount = Model.Count(p => p.QuantityInStock > 0);
    var totalCount = Model.Count();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0 text-danger"><i class="bi bi-exclamation-triangle"></i> Low Stock Dashboard</h2>
        <p class="text-muted mb-0">Monitor and restock inventory items that have reached or fallen below critical thresholds.</p>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary">&larr; Back to Full Catalog</a>
    </div>
</div>

<!-- Threshold Filter & Quick Buttons -->
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" asp-action="LowStock" class="row g-3 align-items-center">
            <div class="col-auto">
                <label for="thresholdInput" class="col-form-label fw-bold">Stock Threshold:</label>
            </div>
            <div class="col-auto">
                <input type="number" id="thresholdInput" name="threshold" value="@currentThreshold" min="1" max="1000" class="form-control" style="width: 110px;" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">Apply Threshold</button>
            </div>
            <div class="col-auto ms-auto">
                <span class="text-muted me-2">Quick Presets:</span>
                <a asp-action="LowStock" asp-route-threshold="5" class="btn btn-sm @(currentThreshold == 5 ? "btn-dark" : "btn-outline-secondary")">5</a>
                <a asp-action="LowStock" asp-route-threshold="10" class="btn btn-sm @(currentThreshold == 10 ? "btn-dark" : "btn-outline-secondary")">10</a>
                <a asp-action="LowStock" asp-route-threshold="20" class="btn btn-sm @(currentThreshold == 20 ? "btn-dark" : "btn-outline-secondary")">20</a>
            </div>
        </form>
    </div>
</div>

<!-- KPI Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-danger shadow-sm">
            <div class="card-body text-center">
                <h6 class="text-muted text-uppercase mb-1">Out of Stock (Critical)</h6>
                <h2 class="display-6 fw-bold text-danger mb-0">@outOfStockCount</h2>
                <small class="text-muted">Requires immediate replenishment</small>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-warning shadow-sm">
            <div class="card-body text-center">
                <h6 class="text-muted text-uppercase mb-1">Low Stock Warning</h6>
                <h2 class="display-6 fw-bold text-warning mb-0">@lowStockCount</h2>
                <small class="text-muted">Stock &le; @currentThreshold units</small>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-secondary shadow-sm">
            <div class="card-body text-center">
                <h6 class="text-muted text-uppercase mb-1">Total Requiring Attention</h6>
                <h2 class="display-6 fw-bold text-dark mb-0">@totalCount</h2>
                <small class="text-muted">Combined restock list</small>
            </div>
        </div>
    </div>
</div>

<!-- Products Table or Empty State -->
@if (Model.Any())
{
    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <span class="fw-bold">Items Requiring Restock (Threshold &le; @currentThreshold)</span>
            <span class="badge bg-danger">@totalCount items found</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Product Name</th>
                        <th>SKU</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Current Stock</th>
                        <th>Status</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.OrderBy(p => p.QuantityInStock))
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>
                                <strong>@item.Name</strong>
                                @if (!string.IsNullOrWhiteSpace(item.BarCode))
                                {
                                    <br /><small class="text-muted">Barcode: @item.BarCode</small>
                                }
                            </td>
                            <td><code>@item.SKU</code></td>
                            <td>@item.CategoryName</td>
                            <td>@item.Price.ToString("C")</td>
                            <td>
                                <strong class="@(item.QuantityInStock == 0 ? "text-danger" : "text-warning") fs-5">
                                    @item.QuantityInStock
                                </strong>
                            </td>
                            <td>
                                @if (item.QuantityInStock == 0)
                                {
                                    <span class="badge bg-danger">Out of Stock</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Low Stock</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="AdjustStock" asp-route-id="@item.Id" class="btn btn-sm btn-warning">
                                    + Restock
                                </a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">
                                    Details
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="card border-success shadow-sm text-center py-5">
        <div class="card-body">
            <h3 class="text-success mb-2">&#10004; Healthy Inventory!</h3>
            <p class="text-muted mb-3">All products in the catalog have stock greater than <strong>@currentThreshold</strong> units.</p>
            <a asp-action="LowStock" asp-route-threshold="50" class="btn btn-outline-secondary btn-sm">Try higher threshold (e.g. 50)</a>
        </div>
    </div>
}
