{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=inventory_db;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "JWT": {
    "Key": "REPLACE_WITH_YOUR_OWN_SECRET_KEY_AT_LEAST_32_CHARS_LONG",
    "Issuer": "InventorySystem.API",
    "Audience": "InventorySystem.Web",
    "ExpiryMinutes": 60
  }
}
